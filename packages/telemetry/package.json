{
  "name": "@vibecloud/telemetry",
  "version": "0.1.0",
  "description": "OpenTelemetry runtime for Vibecloud functions",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://git.sourcecraft.dev/organization-vladimir-nagasena/vibecloud.git",
    "directory": "packages/telemetry"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "index.d.ts",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node26 --outfile=dist/index.js",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "node --test test/*.test.ts",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
