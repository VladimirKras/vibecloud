{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": {{TYPES}}
  },
  "include": ["build.ts", "eslint.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
